<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Todo lo lee</title>
<%- include('modules/links') %>
<link rel="stylesheet" href="/stylesheets/index.css">
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-lg bg-black ">
  <div class="container-fluid">
    <a class="navbar-brand text-white-50" href="/">Inicio</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="d-flex gap-2">
      <button 
        class="btn btn-outline-secondary"
        onclick="window.location.href='/register'"
        >Registrar</button>
      </div>
    </div>
  </nav>
      </header>
    <main>
      <div class="section-1">
  </div>
  <div class="section-2 mt-5">

       <div class="d-flex flex-wrap justify-content-center gap-3">

        <% users.forEach((elem)=>{ %>

            <div class="card bg-black  text-light-emphasis" style="width: 18rem">
             <img src="/images/users/<%= elem.picture?elem.picture :'user.png' %>" alt=""
             class="card-img-top">
              <div class="card-body">
                <h5 class="card-title"> Nombre: <%= elem.name %></h5>
                <p class="card-text">
                  Apellidos:  <%= elem.lastname %>
                </p>
                <p class="card-text">
                  Email:  <%= elem.email %>
                </p>
                <p class="card-text">
                 Descripción;   <%= elem.description %>
                </p>
          <a href="/user/profile/<%= elem.user_id %>" 
                  class="btn btn-primary">Ver perfil</a>
           </div>
         </div>
         <% }) %>
       </div>
     </div>
   </main>
                  
                
               
          
    
     
   <footer></footer>
    
  </body>
</html>